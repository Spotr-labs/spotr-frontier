{
  "name": "spotr-markets",
  "description": "SPOTR mobile-first Solana opinion markets with an Anchor settlement program",
  "keywords": [
    "anchor",
    "markets",
    "nextjs",
    "prediction-markets",
    "solana",
    "spotr",
    "typescript"
  ],
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "anchor-build": "cd anchor && anchor build",
    "anchor-test": "cd anchor && anchor test --skip-deploy",
    "build": "npm run generate:public-config && next build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "codama:js": "codama run js",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:push:devnet": "dotenv -e .env.devnet -- prisma db push",
    "db:seed": "node --env-file=.env.local scripts/seed-spotr.mjs",
    "db:seed:devnet": "node --env-file=.env.devnet scripts/seed-spotr.mjs",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:studio:devnet": "dotenv -e .env.devnet -- prisma studio",
    "reset:devnet": "node --env-file=.env.devnet scripts/reset-app.mjs",
    "reset:local": "node --env-file=.env.local scripts/reset-app.mjs",
    "dev": "npm run generate:public-config && next dev",
    "dev:devnet": "bash scripts/dev-devnet.sh",
    "dev:local": "bash scripts/dev-local.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:public-config": "node scripts/generate-public-config.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "setup": "npm run db:push && npm run db:seed && npm run anchor-build && npm run codama:js",
    "start": "next start",
    "test:e2e": "bash tests/e2e/run-e2e.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@privy-io/react-auth": "^3.22.1",
    "@privy-io/server-auth": "^1.32.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@solana-program/memo": "^0.11.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.3.0",
    "@solana/kit-client-rpc": "^0.7.0",
    "@solana/kit-plugin-rpc": "^0.7.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.11.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "swr": "^2.2.0",
    "tailwind-merge": "^3.5.0",
    "ws": "8.18.3"
  },
  "overrides": {
    "ws": "8.18.3"
  },
  "pnpm": {
    "overrides": {
      "ws": "8.18.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@reown/appkit",
      "bufferutil",
      "esbuild",
      "keccak",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.3.8",
    "@codama/renderers-js": "^1.5.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "codama": "^1.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "lightningcss": "^1.32.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
